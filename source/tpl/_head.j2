<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
<!--
  Seneca shared homepage system — one shell for the master site + 9 child sites.
  A child site changes ONLY the 5 tokens below, its logo, its photography and its copy.
  Photography: free Unsplash images (unsplash.com/license), hot-linked as placeholders.
-->
<style>
:root{
  /* Parent brand — locked on every site */
  --ink:#2a292a; --brand:#533095; --white:#ffffff;
  --muted:#6b6870; --line:#ecebef; --line-2:#d9d6de; --soft:#f6f4f9;
  /* Property tokens — the only colours a child site changes */
  --accent:{{ t.accent }};        /* fills, rules, dots, primary CTA */
  --accent-ink:{{ t.ink }};       /* links + labels on white (>=4.5:1) */
  --on-accent:{{ t.onAccent }};   /* text on accent buttons */
  --deep:{{ t.deep }};            /* hero / band / footer fallback */
  --tint:{{ t.tint }};            /* soft section ground */
  --font:'Inter Tight','Helvetica Neue',Arial,sans-serif;
  --gutter:32px; --header-h:{{ 88 if child else 80 }}px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 16px)}
body{margin:0;background:var(--white);color:var(--ink);font-family:var(--font);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img{display:block;max-width:100%}
a{color:inherit}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.skip{position:absolute;left:-9999px;top:8px;background:var(--ink);color:#fff;padding:10px 14px;z-index:100}
.skip:focus{left:8px}
.pad{padding-left:var(--gutter);padding-right:var(--gutter)}
.link{text-decoration:none}
.link:hover{text-decoration:underline;text-underline-offset:4px}

/* ---------- Type ---------- */
.display{margin:0;font-weight:500;font-size:clamp(54px,8.6vw,148px);line-height:.92;letter-spacing:-.045em}
.h2{margin:0;font-weight:500;font-size:clamp(44px,6vw,96px);line-height:.95;letter-spacing:-.04em}
.kicker{margin:0 0 16px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px}
.lede{margin:0;font-size:17px;line-height:1.55;color:var(--muted)}
.meta{font-size:14px;color:var(--muted)}
.label{font-size:12px;letter-spacing:.06em;text-transform:uppercase;font-weight:600}
.dot{width:10px;height:10px;border-radius:99px;flex:none;display:inline-block}
.dot.sm{width:8px;height:8px}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;font:inherit;font-size:15px;font-weight:500;text-decoration:none;border:1px solid transparent;cursor:pointer;transition:filter .2s ease,background .2s ease,color .2s ease}
.btn:hover{filter:brightness(1.1)}
.btn.sm{height:44px;padding:0 18px;font-size:14px}
.btn-accent{background:var(--accent);color:var(--on-accent);font-weight:600}
.btn-dark{background:var(--ink);color:#fff}
.btn-brand{background:var(--brand);color:#fff}
.btn-white{background:#fff;color:var(--ink)}
.btn-ghost{border-color:var(--ink);color:var(--ink);background:transparent}
.btn-ghost-light{border-color:rgba(255,255,255,.6);color:#fff;background:transparent}
.btn-quiet{border-color:var(--line-2);color:var(--ink);background:#fff}
.chip{font:inherit;font-size:14px;height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--line-2);background:#fff;color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
.select{font:inherit;font-size:14px;height:40px;border-radius:999px;border:1px solid var(--line-2);padding:0 14px;color:var(--ink);background:#fff}

/* ---------- Header ---------- */
.parent-band{background:var(--ink);color:#fff;font-size:13px;min-height:40px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 16px}
.parent-band a{color:#fff}
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line);height:var(--header-h);display:flex;align-items:center;justify-content:space-between;gap:24px}
.site-header.has-rule{border-top:4px solid var(--accent)}
.site-header .logo img{height:{{ 60 if child else 54 }}px;width:auto}
.main-nav{display:flex;gap:26px;font-size:14px}
.main-nav a{color:var(--ink);text-decoration:none;padding:6px 0}
.main-nav a:hover{text-decoration:underline;text-underline-offset:4px}
.menu-btn{display:none;width:44px;height:44px;border-radius:999px;border:1px solid var(--line-2);background:#fff;align-items:center;justify-content:center;color:var(--ink);cursor:pointer}
.drawer{position:fixed;inset:0;z-index:80;background:#fff;padding:24px var(--gutter);display:none;flex-direction:column;gap:8px;overflow:auto}
.drawer.open{display:flex}
.drawer a{font-size:30px;font-weight:500;letter-spacing:-.02em;text-decoration:none;padding:10px 0;border-bottom:1px solid var(--line)}
.drawer .close{align-self:flex-end}

/* ---------- Hero (sticky, parallax) ---------- */
.hero{position:sticky;top:0;z-index:0;height:min(900px,100vh);min-height:640px;overflow:hidden;background:var(--deep);color:#fff}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform-origin:60% 50%}
.hero-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1) 0%,rgba(0,0,0,.25) 40%,rgba(0,0,0,.8) 100%)}
.hero-body{position:absolute;left:0;right:0;bottom:0;padding-bottom:40px;display:flex;flex-direction:column;gap:36px}
.hero-row{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:32px}
.hero-side{max-width:370px;display:flex;flex-direction:column;gap:20px;padding-bottom:10px}
.hero-side p{margin:0;font-size:17px;line-height:1.5;color:#efedf3}
.btn-row{display:flex;flex-wrap:wrap;gap:12px}
.jump{border-top:1px solid rgba(255,255,255,.28);padding-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;font-size:14px}
.jump a{color:#fff;display:flex;align-items:center;gap:10px;text-decoration:none}
.jump a:hover{text-decoration:underline;text-underline-offset:4px}
.jump span.where{color:#cfc9da}
.page{position:relative;z-index:1;background:#fff}

/* ---------- Sections ---------- */
.section{padding-top:96px;padding-bottom:96px}
.sec-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px}
.bar{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:15px;padding-bottom:12px}
.grid{display:grid;gap:16px}
.g-4{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.g-3{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}

/* image well with inner parallax */
.well{position:relative;overflow:hidden;background:var(--deep)}
.well > img.px{position:absolute;left:0;top:-10%;width:100%;height:120%;object-fit:cover;transition:filter .5s ease}
.card:hover .well > img.px{filter:brightness(1.08)}
.r-45{aspect-ratio:4/5}.r-1610{aspect-ratio:16/10}.r-34{aspect-ratio:3/4}.r-11{aspect-ratio:1/1}

/* property card */
.prop{display:flex;flex-direction:column;gap:14px}
.prop .well .plogo{position:absolute;left:20px;bottom:20px;height:64px;width:auto}
.prop-cap{border-top:3px solid var(--c);padding-top:12px;display:flex;flex-direction:column;gap:6px}
.prop-cap h3{margin:0;font-size:17px;font-weight:500}
.prop-cap p{margin:0}
.prop-actions{display:flex;flex-wrap:wrap;gap:20px;margin-top:6px;font-size:14px}

/* offer card */
.offer{display:flex;flex-direction:column;border:1px solid var(--line)}
.offer-body{padding:20px;display:flex;flex-direction:column;gap:10px;flex-grow:1}
.offer h3{margin:0;font-size:22px;font-weight:500;letter-spacing:-.01em}
.facts{margin:0;display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:14px;color:var(--muted)}
.facts dd{margin:0;color:var(--ink)}
.offer .btn{margin-top:auto;align-self:flex-start}
.badge{position:absolute;top:14px;left:14px;background:var(--brand);color:#fff;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:999px}

/* "more work" list with floating preview */
.xp{display:flex;flex-wrap:wrap;gap:32px;align-items:flex-start}
.xp-list{list-style:none;margin:0;padding:0;flex:999 1 560px;min-width:0;border-top:1px solid var(--line)}
.xp-list li{border-bottom:1px solid var(--line)}
.xp-row{display:grid;grid-template-columns:88px minmax(0,1fr) minmax(0,1fr) 24px;gap:20px;align-items:center;padding:14px 8px;text-decoration:none;color:var(--ink);transition:background .2s ease}
.xp-row:hover,.xp-row.on{background:var(--soft)}
.xp-row img{width:88px;height:60px;object-fit:cover}
.xp-row .name{font-size:18px;font-weight:500}
.xp-where{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:13px;color:var(--muted)}
.xp-where span{display:inline-flex;align-items:center;gap:6px}
.xp-fig{margin:0;flex:1 1 360px;position:sticky;top:calc(var(--header-h) + 24px);aspect-ratio:4/3;overflow:hidden;background:var(--deep)}
.xp-fig img{width:100%;height:100%;object-fit:cover;transition:opacity .35s ease}
.xp-fig figcaption{position:absolute;left:16px;bottom:14px;color:#fff;font-size:14px;font-weight:500;text-shadow:0 1px 8px rgba(0,0,0,.5)}

/* events */
.events{list-style:none;margin:0;padding:0;border-top:1px solid var(--line-2)}
.ev{display:grid;grid-template-columns:96px minmax(0,2fr) minmax(0,1.3fr) auto;gap:24px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line-2)}
.ev .day{font-size:44px;font-weight:500;letter-spacing:-.03em;line-height:1}
.ev .mon{font-size:13px;color:#4a484d;margin-top:4px}
.ev .title{font-size:20px;font-weight:500}
.ev .sub{font-size:14px;color:#4a484d;margin-top:4px}
.ev .venue{display:inline-flex;align-items:center;gap:8px;font-size:14px}

/* feature band (parallax) */
.band{position:relative;overflow:hidden;background:var(--deep);color:#fff}
.band > img.px{position:absolute;left:0;top:-12%;width:100%;height:124%;object-fit:cover}
.band-scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.86) 0%,rgba(0,0,0,.66) 55%,rgba(0,0,0,.72) 100%)}
.band-body{position:relative;padding-top:150px;padding-bottom:150px;display:flex;flex-wrap:wrap;gap:48px;align-items:flex-end;justify-content:space-between}
.band h2{margin:0;font-weight:500;font-size:clamp(44px,6.4vw,104px);line-height:.95;letter-spacing:-.04em}
.band-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.band-list li{border-top:1px solid rgba(255,255,255,.28)}
.band-list a{display:flex;justify-content:space-between;align-items:center;padding:16px 0;color:#fff;font-size:18px;text-decoration:none}
.band-list a:hover{text-decoration:underline;text-underline-offset:4px}
.benefits{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px;font-size:16px;line-height:1.45}
.benefits li{border-top:1px solid rgba(255,255,255,.25);padding-top:14px}

/* lists, plan, footer */
.rows{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.rows li{border-bottom:1px solid var(--line)}
.rows a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;padding:20px 8px;text-decoration:none;color:var(--ink);transition:background .2s ease}
.rows a:hover{background:var(--soft)}
.rows .big{font-size:clamp(20px,2vw,28px);font-weight:500;letter-spacing:-.02em}
.tag{font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 10px;border-radius:999px;border:1px solid #c9c6cf;color:#4a484d}
.plan{border-top:3px solid var(--c);padding-top:16px;display:flex;flex-direction:column;gap:8px;font-size:15px}
.plan strong{font-size:17px;font-weight:500}
.plan a{color:var(--ink)}
.split{display:flex;flex-wrap:wrap;gap:48px}
.split > *{min-width:0}
.dl{margin:0;display:grid;grid-template-columns:120px minmax(0,1fr);gap:14px 16px;font-size:15px;border-top:3px solid var(--accent);padding-top:20px}
.dl dt{color:var(--muted)}.dl dd{margin:0}
.map{flex:1 1 420px;min-height:420px;position:relative;overflow:hidden;background:var(--tint)}
.map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:grayscale(.3)}
.field{display:flex;flex-direction:column;gap:6px;font-size:13px;color:#d6d2dc}
.field input,.field select{font:inherit;font-size:15px;height:46px;padding:0 14px;border:1px solid #5a585c;background:transparent;color:#fff}
.field select{background:var(--ink)}
.footer{position:relative;overflow:hidden;padding:150px 16px 16px;background:var(--deep)}
.footer > img.px{position:absolute;left:0;top:-10%;width:100%;height:120%;object-fit:cover}
.footer .blur{filter:blur(22px) saturate(1.15);transform:scale(1.1)}
.f-card{position:relative;background:#fff;padding:40px;display:flex;flex-direction:column;gap:64px}
.f-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:32px;font-size:14px}
.f-cols div{display:flex;flex-direction:column;gap:8px}
.f-cols a{text-decoration:none}.f-cols a:hover{text-decoration:underline;text-underline-offset:4px}
.f-legal{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:20px}
.credit{font-size:12px;color:var(--muted)}

/* ---------- Parallax + reveal (CSS scroll-driven; JS fallback below) ---------- */
@keyframes px{from{transform:translate3d(0,-9%,0)}to{transform:translate3d(0,9%,0)}}
@keyframes rise{from{opacity:0;transform:translate3d(0,56px,0)}to{opacity:1;transform:none}}
@keyframes heroImg{from{transform:scale(1.04)}to{transform:scale(1.22) translate3d(0,6%,0)}}
@keyframes heroTxt{from{opacity:1;transform:none}to{opacity:0;transform:translate3d(0,-120px,0)}}
@keyframes drift{from{transform:translate3d(0,80px,0)}to{transform:translate3d(0,-80px,0)}}
@supports (animation-timeline: view()){
  .px{animation:px linear both;animation-timeline:view()}
  .rise{animation:rise linear both;animation-timeline:view();animation-range:entry 0% entry 70%}
  .drift{animation:drift linear both;animation-timeline:view()}
  .hero-img{animation:heroImg linear both;animation-timeline:scroll(root);animation-range:0px 900px}
  .hero-body{animation:heroTxt linear both;animation-timeline:scroll(root);animation-range:0px 700px}
}
.js-reveal .rise{opacity:0;transform:translate3d(0,56px,0);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.js-reveal .rise.in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
  .px,.rise,.drift,.hero-img,.hero-body{animation:none!important;transform:none!important;opacity:1!important;transition:none!important}
  html{scroll-behavior:auto}
}

/* ---------- Responsive ---------- */
@media (max-width:1100px){.main-nav{display:none}.menu-btn{display:inline-flex}}
@media (max-width:700px){
  :root{--gutter:16px}
  .hide-sm{display:none!important}
  .section{padding-top:72px;padding-bottom:72px}
  .ev{grid-template-columns:64px minmax(0,1fr);gap:12px 16px}
  .ev > *:nth-child(n+3){grid-column:2}
  .xp-row{grid-template-columns:64px minmax(0,1fr) 20px}
  .xp-row img{width:64px;height:48px}
  .xp-where{display:none}
  .xp-fig{display:none}
  .f-card{padding:28px 20px}
  .band-body{padding-top:100px;padding-bottom:100px}
}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
